rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Allow a user to write their own profile document
    match /users/{userId} {
      allow create, update, get: if isSignedIn() && request.auth.uid == userId;
      // Allow household members to read each other's user docs.
      // Requires users/{userId}.householdId to be set to a valid household.
      allow get, list: if isSignedIn()
        && resource.data.householdId is string
        && exists(/databases/$(database)/documents/households/$(resource.data.householdId))
        && request.auth.uid in get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.members;
      allow delete: if false;
    }

    match /households/{homeId} {
      // Create: caller must be signed-in, createdBy must equal caller,
      // name must be a string, and members must initially contain only the caller.
      allow create: if isSignedIn()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.members is list
                    && request.resource.data.members.size() == 1
                    && request.resource.data.members[0] == request.auth.uid;

      // Allow existing members to make changes.
      allow update: if isSignedIn() && (request.auth.uid in resource.data.members);

      // Members may read
      allow get, list: if isSignedIn() && request.auth.uid in resource.data.members;

      // Only creator can delete
      allow delete: if isSignedIn() && request.auth.uid == resource.data.createdBy;

      // Subcollections under a household (e.g. household tasks stored under
      // /households/{homeId}/tasks) should authorize based on the parent
      // household document's members array. Use `get()` to read the parent
      // household document and verify the caller is a member.
      match /{subCollection=**} {
        allow read, write: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/households/$(homeId)).data.members;
      }
    }

    // Top-level collections that reference a household by householdId (the app
    // queries `tasks`, `shopping_items`, and `activity_logs` as top-level
    // collections). Authorize access if the calling user is a member of the
    // referenced household.
    match /tasks/{taskId} {
      allow read: if isSignedIn()
        && resource.data.householdId is string
        // Ensure referenced household exists before checking membership to
        // avoid rule evaluation errors when legacy/incorrect docs reference
        // non-existent households.
        && exists(/databases/$(database)/documents/households/$(resource.data.householdId))
        && request.auth.uid in get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.members;

      allow create, update, delete: if isSignedIn()
        && request.resource.data.householdId is string
        && exists(/databases/$(database)/documents/households/$(request.resource.data.householdId))
        && request.auth.uid in get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.members;
    }

    match /shopping_items/{itemId} {
      allow read: if isSignedIn()
        && resource.data.householdId is string
        && exists(/databases/$(database)/documents/households/$(resource.data.householdId))
        && request.auth.uid in get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.members;

      allow create, update, delete: if isSignedIn()
        && request.resource.data.householdId is string
        && exists(/databases/$(database)/documents/households/$(request.resource.data.householdId))
        && request.auth.uid in get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.members;
    }

    match /activity_logs/{logId} {
      allow read: if isSignedIn()
        && resource.data.householdId is string
        && exists(/databases/$(database)/documents/households/$(resource.data.householdId))
        && request.auth.uid in get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.members;

      allow create: if isSignedIn()
        && request.resource.data.householdId is string
        && exists(/databases/$(database)/documents/households/$(request.resource.data.householdId))
        && request.auth.uid in get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.members;
    }

    // Allow a user to read/write their own nested documents under /users/{uid}/...
    match /users/{userId}/{subCollection=**} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
