{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flutter Run (mode, CLI device prompt)",
      "type": "shell",
      "command": "flutter",
      "args": [
        "run",
        "--${input:mode}",
        "--dart-define-from-file=.env"
      ],
      "options": {
        "cwd": "${workspaceFolder}/housekeepr"
      },
      "group": "build",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "mode",
      "type": "pickString",
      "description": "Select build mode",
      "options": [
        "debug",
        "release"
      ],
      "default": "debug"
    }
  ]
}
