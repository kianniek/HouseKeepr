<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coffee_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1F1B18"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/coffee_idle_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        tools:visibility="gone">

        <TextView
            android:id="@+id/coffee_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="What to brew?"
            android:textColor="#A1887F"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/coffee_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="▼"
            android:textColor="#D7CCC8"
            android:textSize="10sp" />

        <ImageView
            android:id="@+id/coffee_spinner"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:src="@drawable/wheel_frame" />

        <TextView
            android:id="@+id/coffee_spin_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_rounded_spin_button"
            android:paddingLeft="12dp"
            android:paddingTop="5dp"
            android:paddingRight="12dp"
            android:paddingBottom="5dp"
            android:text="TAP TO SPIN"
            android:textColor="#1F1B18"
            android:textSize="10sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/coffee_recipe_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="top|center_horizontal"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/coffee_recipe_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="@string/latte"
                android:textColor="@color/coffee_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/coffee_recipe_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/tap_for_recipe"
                android:textColor="@color/coffee_text_secondary"
                android:textSize="8sp" />

            <LinearLayout
                android:id="@+id/coffee_layers_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="8dp"
                android:background="@color/coffee_bg_light"
                android:gravity="bottom"
                android:orientation="vertical"
                android:padding="2dp">

                <TextView
                    android:id="@+id/coffee_layer_0"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/coffee_text_dark"
                    android:textSize="8sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/coffee_layer_1"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/coffee_text_dark"
                    android:textSize="8sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/coffee_layer_2"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/coffee_text_dark"
                    android:textSize="8sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/coffee_layer_3"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/coffee_text_dark"
                    android:textSize="8sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/coffee_reset"
                android:layout_width="match_parent"
                android:layout_height="27sp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_rounded_spin_button"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:text="@string/spin_again"
                android:textColor="@color/coffee_button_text"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>
</FrameLayout>