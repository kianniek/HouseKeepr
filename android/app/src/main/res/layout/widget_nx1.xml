<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_container_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal|center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    style="@style/Widget.Android.AppWidget.Container"
    android:theme="@style/Theme.Android.AppWidgetContainer">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingLeft="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="8dp"
            android:paddingRight="12dp"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/icon_shopping_cart"
                android:src="@drawable/ic_shopping_cart" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/amount_items_left"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="start|center_vertical"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp"
                android:visibility="invisible"
                tools:text="1 Item to go"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/widget_empty_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="start|center_vertical"
                android:text="@string/no_items"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp"
                android:visibility="invisible"
                tools:text="No Items left"
                tools:visibility="visible" />
        </FrameLayout>

    </LinearLayout>


    <LinearLayout
        android:id="@+id/widget_container_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <!-- Tick / checkbox icon: separate clickable area for toggle only -->

        <!-- Item name and quantity: clickable to open app -->
        <LinearLayout
            android:id="@+id/item_checkbox_area"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="start|center_vertical"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            android:translationX="-16dp">

            <ImageView
                android:id="@+id/item_tick"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/toggle_item"
                android:src="@drawable/ic_checkbox_unchecked" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/item_content_area"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Item name -->
            <TextView
                android:id="@+id/next_item_text"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:textAlignment="gravity"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp" />

            <!-- Quantity badge (circular background, hidden when qty == 1) -->
            <TextView
                android:id="@+id/item_quantity_badge"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/quantity_badge_bg"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>
</LinearLayout>
